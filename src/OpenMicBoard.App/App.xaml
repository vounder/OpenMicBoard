<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenMicBoard.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenMicBoard.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="GraphiteBackgroundColor">#FF101315</Color>
            <Color x:Key="GraphiteSurfaceColor">#D91A1F22</Color>
            <Color x:Key="GraphiteSurfaceHoverColor">#F022292D</Color>
            <Color x:Key="MintAccentColor">#FF9FE7D7</Color>
            <Color x:Key="MutedTextColor">#FFA8B1B5</Color>

            <SolidColorBrush x:Key="GraphiteBackgroundBrush" Color="{StaticResource GraphiteBackgroundColor}" />
            <SolidColorBrush x:Key="GraphiteSurfaceBrush" Color="{StaticResource GraphiteSurfaceColor}" />
            <SolidColorBrush x:Key="GraphiteSurfaceHoverBrush" Color="{StaticResource GraphiteSurfaceHoverColor}" />
            <SolidColorBrush x:Key="MintAccentBrush" Color="{StaticResource MintAccentColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GraphiteSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="90" />
            </Style>

            <Style x:Key="MintButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource MintAccentBrush}" />
                <Setter Property="Foreground" Value="#FF0A1513" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
