<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenMicBoard.App.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenMicBoard.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenMicBoard.App.ViewModels"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            MaxWidth="1540"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock
                        Text="LOCAL / PRIVATE / FAST"
                        Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock
                        Text="Your voice, plus the perfect cue."
                        FontFamily="Segoe UI Variable Display"
                        FontSize="34"
                        FontWeight="SemiBold" />
                    <TextBlock
                        MaxWidth="620"
                        HorizontalAlignment="Left"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Mix your microphone and local sounds into any virtual audio route. Nothing leaves this PC unless you explicitly check for updates."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        AccessKey="B"
                        Click="OnAddSoundClick"
                        Style="{StaticResource MintButtonStyle}"
                        ToolTipService.ToolTip="Open the file browser and choose one or more audio files">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                            <TextBlock Text="Browse audio files" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.StopAllCommand}"
                        CornerRadius="12"
                        Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            <TextBlock Text="Stop all" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="46"
                        Height="46"
                        VerticalAlignment="Center"
                        Background="#189FE7D7"
                        CornerRadius="14">
                        <FontIcon
                            Foreground="{StaticResource MintAccentBrush}"
                            Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="VIRTUAL OUTPUT" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox
                            MinWidth="210"
                            ItemsSource="{x:Bind ViewModel.RenderEndpoints}"
                            PlaceholderText="Choose an output"
                            SelectedItem="{x:Bind ViewModel.SelectedRenderEndpoint, Mode=TwoWay}"
                            SelectionChanged="OnDeviceSelectionChanged"
                            DisplayMemberPath="DisplayName" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="MICROPHONE / OPTIONAL" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox
                            MinWidth="210"
                            ItemsSource="{x:Bind ViewModel.CaptureEndpoints}"
                            PlaceholderText="Sound-only mode"
                            SelectedItem="{x:Bind ViewModel.SelectedCaptureEndpoint, Mode=TwoWay}"
                            SelectionChanged="OnDeviceSelectionChanged"
                            DisplayMemberPath="DisplayName" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6">
                        <TextBlock Text="PRIVATE PREVIEW" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox
                            MinWidth="210"
                            ItemsSource="{x:Bind ViewModel.PreviewEndpoints}"
                            PlaceholderText="Choose headphones"
                            SelectedItem="{x:Bind ViewModel.SelectedPreviewEndpoint, Mode=TwoWay}"
                            SelectionChanged="OnDeviceSelectionChanged"
                            DisplayMemberPath="DisplayName" />
                    </StackPanel>

                    <Button
                        Grid.Column="4"
                        MinWidth="142"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ToggleAudioCommand}"
                        Style="{StaticResource MintButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="Start / stop route" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel>
                                    <TextBlock Text="SOUNDBOARD" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ActiveProfileTitle, Mode=OneWay}"
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="24"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Click="OnAddSoundClick"
                                    ToolTipService.ToolTip="Choose WAV, MP3, or OGG files">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                                        <TextBlock Text="Browse files" />
                                    </StackPanel>
                                </Button>
                                <ComboBox
                                    MinWidth="170"
                                    ItemsSource="{x:Bind ViewModel.Profiles}"
                                    SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                    DisplayMemberPath="Name" />
                                <Button
                                    Command="{x:Bind ViewModel.AddProfileCommand}"
                                    ToolTipService.ToolTip="Create profile">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <GridView
                            Grid.Row="1"
                            MinHeight="330"
                            ItemsSource="{x:Bind ViewModel.Pads}"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        MaximumRowsOrColumns="4"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SoundPadViewModel">
                                    <Border
                                        Width="208"
                                        Height="150"
                                        Margin="0,0,12,12"
                                        Padding="16"
                                        Background="#B51E2428"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Border
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Left"
                                                    Background="#199FE7D7"
                                                    CornerRadius="10">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Foreground="{StaticResource MintAccentBrush}"
                                                        Glyph="{x:Bind Glyph}" />
                                                </Border>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{x:Bind PreviewCommand}"
                                                    ToolTipService.ToolTip="Preview only">
                                                    <FontIcon FontSize="13" Glyph="&#xE767;" />
                                                </Button>
                                            </Grid>
                                            <Button
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Left"
                                                VerticalContentAlignment="Bottom"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind PlayCommand}"
                                                Padding="0">
                                                <StackPanel>
                                                    <TextBlock
                                                        MaxWidth="165"
                                                        Text="{x:Bind Name}"
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        MaxWidth="165"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        Text="{x:Bind Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Grid.Row="2"
                                                HorizontalAlignment="Left"
                                                Click="OnSetHotkeyClick"
                                                Content="{x:Bind Subtitle}"
                                                FontSize="11"
                                                Padding="6,3"
                                                ToolTipService.ToolTip="Set global shortcut" />
                                            <Button
                                                Grid.Row="2"
                                                HorizontalAlignment="Right"
                                                Command="{x:Bind StopCommand}"
                                                ToolTipService.ToolTip="Stop this sound">
                                                <FontIcon FontSize="11" Glyph="&#xE71A;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <InfoBar
                            Grid.Row="1"
                            MaxWidth="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                            Message="Add a WAV, MP3, or OGG file to create your first pad."
                            Severity="Informational"
                            Title="Your soundboard is ready.">
                            <InfoBar.ActionButton>
                                <Button Click="OnAddSoundClick">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                                        <TextBlock Text="Choose files" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="20">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="ROUTE STATUS" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <ProgressRing
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Left"
                                IsIndeterminate="True"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Foreground="{StaticResource MintAccentBrush}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.RefreshDevicesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    <TextBlock Text="Refresh devices" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabelStyle}" />
                            <ToggleSwitch
                                x:Name="UpdateConsentToggle"
                                Header="Check GitHub for updates"
                                IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}"
                                OffContent="Offline"
                                OnContent="Opted in"
                                Toggled="OnUpdateConsentToggled" />
                            <ToggleSwitch
                                x:Name="AutostartToggle"
                                Header="Start with Windows"
                                IsOn="{x:Bind ViewModel.Autostart, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="Starts minimized"
                                Toggled="OnAutostartToggled" />
                            <ComboBox
                                x:Name="BufferProfileSelector"
                                Header="Audio buffer"
                                ItemsSource="{x:Bind ViewModel.BufferProfiles}"
                                SelectedItem="{x:Bind ViewModel.SelectedBufferProfile, Mode=TwoWay}"
                                SelectionChanged="OnBufferSelectionChanged" />
                            <TextBlock
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="No telemetry, accounts, cloud sync, or automatic downloads."
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                                Content="Check now" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
